{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modose.app/schemas/scene-comparison/1.0",
  "title": "SceneComparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "modelId",
    "promptVersion",
    "repaired",
    "matches",
    "addedObjects"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"const": "ok"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 128},
    "promptVersion": {"const": "compare-v1"},
    "repaired": {"type": "boolean"},
    "matches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/Match"}
    },
    "addedObjects": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/AddedObject"}
    }
  },
  "$defs": {
    "Coordinate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "BoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yMin", "xMin", "yMax", "xMax"],
      "properties": {
        "yMin": {"$ref": "#/$defs/Coordinate"},
        "xMin": {"$ref": "#/$defs/Coordinate"},
        "yMax": {"$ref": "#/$defs/Coordinate"},
        "xMax": {"$ref": "#/$defs/Coordinate"}
      }
    },
    "Match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineObjectId",
        "state",
        "confidence",
        "currentBox",
        "ambiguityReason"
      ],
      "properties": {
        "baselineObjectId": {"type": "string", "minLength": 1, "maxLength": 64},
        "state": {
          "enum": [
            "aligned",
            "moved",
            "rotated",
            "moved_rotated",
            "missing",
            "occluded",
            "ambiguous"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "currentBox": {
          "oneOf": [
            {"$ref": "#/$defs/BoundingBox"},
            {"type": "null"}
          ]
        },
        "ambiguityReason": {"type": "string", "maxLength": 240}
      }
    },
    "AddedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "currentBox", "confidence"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
        "currentBox": {"$ref": "#/$defs/BoundingBox"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
