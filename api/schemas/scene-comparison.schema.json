{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modose.app/schemas/scene-comparison/1.0",
  "title": "SceneComparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "modelId", "promptVersion", "matches", "extraObjects"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"const": "ok"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 128},
    "promptVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "matches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/Match"}
    },
    "extraObjects": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/ExtraObject"}
    }
  },
  "$defs": {
    "Coordinate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "BoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yMin", "xMin", "yMax", "xMax"],
      "properties": {
        "yMin": {"$ref": "#/$defs/Coordinate"},
        "xMin": {"$ref": "#/$defs/Coordinate"},
        "yMax": {"$ref": "#/$defs/Coordinate"},
        "xMax": {"$ref": "#/$defs/Coordinate"}
      }
    },
    "ReasonCode": {
      "enum": [
        "POSITION_ALIGNED",
        "POSITION_CHANGED",
        "ORIENTATION_CHANGED",
        "OBJECT_MISSING",
        "OBJECT_OCCLUDED",
        "OBJECT_AMBIGUOUS"
      ]
    },
    "Match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneObjectId",
        "state",
        "currentBoundingBox",
        "sameObjectConfidence",
        "orientationDeltaDegrees",
        "occludedBy",
        "reasonCodes"
      ],
      "properties": {
        "sceneObjectId": {"type": "string", "pattern": "^obj_[0-9]{2}$"},
        "state": {
          "enum": ["aligned", "moved", "rotated", "moved_rotated", "missing", "occluded", "ambiguous"]
        },
        "currentBoundingBox": {
          "oneOf": [
            {"$ref": "#/$defs/BoundingBox"},
            {"type": "null"}
          ]
        },
        "sameObjectConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "orientationDeltaDegrees": {
          "oneOf": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "null"}
          ]
        },
        "occludedBy": {
          "oneOf": [
            {"type": "string", "pattern": "^obj_[0-9]{2}$"},
            {"type": "null"}
          ]
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/ReasonCode"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "missing"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "currentBoundingBox": {"type": "null"},
              "orientationDeltaDegrees": {"type": "null"},
              "occludedBy": {"type": "null"}
            }
          }
        }
      ]
    },
    "ExtraObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "boundingBox", "confidence"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "boundingBox": {"$ref": "#/$defs/BoundingBox"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
