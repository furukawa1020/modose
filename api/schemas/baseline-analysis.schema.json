{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modose.app/schemas/baseline-analysis/1.0",
  "title": "BaselineAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "modelId",
    "promptVersion",
    "repaired",
    "objects",
    "excludedCandidates"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"const": "ok"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 128},
    "promptVersion": {"const": "baseline-v1"},
    "repaired": {"type": "boolean"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/Object"}
    },
    "excludedCandidates": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/ExcludedCandidate"}
    }
  },
  "$defs": {
    "Coordinate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "BoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yMin", "xMin", "yMax", "xMax"],
      "properties": {
        "yMin": {"$ref": "#/$defs/Coordinate"},
        "xMin": {"$ref": "#/$defs/Coordinate"},
        "yMax": {"$ref": "#/$defs/Coordinate"},
        "xMax": {"$ref": "#/$defs/Coordinate"}
      }
    },
    "Object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "appearanceFeatures",
        "boundingBox",
        "orientationImportant",
        "symmetry"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
        "appearanceFeatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "boundingBox": {"$ref": "#/$defs/BoundingBox"},
        "orientationImportant": {"type": "boolean"},
        "symmetry": {"enum": ["none", "bilateral", "rotational"]}
      }
    },
    "ExcludedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "reason"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
        "reason": {
          "enum": [
            "transparent",
            "reflective",
            "deformable",
            "unsupported_shape",
            "fixed",
            "duplicate_appearance"
          ]
        }
      }
    }
  }
}
