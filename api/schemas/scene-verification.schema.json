{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modose.app/schemas/scene-verification/1.0",
  "title": "SceneVerification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "modelId",
    "promptVersion",
    "repaired",
    "verificationStatus",
    "corrections",
    "uncertaintyReason"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"const": "ok"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 128},
    "promptVersion": {"const": "verify-v1"},
    "repaired": {"type": "boolean"},
    "verificationStatus": {
      "enum": ["verified", "needs_correction", "uncertain"]
    },
    "corrections": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/Correction"}
    },
    "uncertaintyReason": {"type": "string", "maxLength": 512}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verificationStatus": {"const": "verified"}},
        "required": ["verificationStatus"]
      },
      "then": {
        "properties": {
          "corrections": {"maxItems": 0},
          "uncertaintyReason": {"maxLength": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"verificationStatus": {"const": "needs_correction"}},
        "required": ["verificationStatus"]
      },
      "then": {
        "properties": {
          "corrections": {"minItems": 1},
          "uncertaintyReason": {"maxLength": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"verificationStatus": {"const": "uncertain"}},
        "required": ["verificationStatus"]
      },
      "then": {
        "properties": {
          "corrections": {"maxItems": 0},
          "uncertaintyReason": {"minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "Correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineObjectId", "reason"],
      "properties": {
        "baselineObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
