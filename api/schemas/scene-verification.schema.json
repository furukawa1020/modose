{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modose.app/schemas/scene-verification/1.0",
  "title": "SceneVerification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "modelId", "promptVersion", "objects", "overall"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"const": "ok"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 128},
    "promptVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/Verification"}
    },
    "overall": {"enum": ["verified", "needs_correction", "uncertain"]}
  },
  "$defs": {
    "ReasonCode": {
      "enum": [
        "POSITION_ALIGNED",
        "POSITION_CHANGED",
        "ORIENTATION_CHANGED",
        "OBJECT_MISSING",
        "OBJECT_AMBIGUOUS",
        "LOW_CONFIDENCE"
      ]
    },
    "Verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneObjectId", "result", "confidence", "reasonCodes"],
      "properties": {
        "sceneObjectId": {"type": "string", "pattern": "^obj_[0-9]{2}$"},
        "result": {"enum": ["verified", "needs_correction", "uncertain"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/ReasonCode"}
        }
      }
    }
  }
}
